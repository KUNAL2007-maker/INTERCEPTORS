# ─────────────────────────────────────────────────────────────────────────────
# CryptoTrace (SIH26183) — environment
#
# EVERY key below is OPTIONAL. With none set, the console runs a fully-featured
# demo: /api/trace serves a realistic multi-chain laundering scenario, the I4C
# assistant answers from the built-in forensic engine (no network), and the app
# signs you straight in as a local officer with nothing persisted. Add keys to
# go live. Copy this file to `.env.local` and fill in what you have.
#
# `.env.local` is gitignored. Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (login + case persistence) ─────────────────────────────────────
# Without these the console runs in "offline demo" mode: no login screen, and
# traces / notices / case metadata vanish on refresh. With them, each officer
# signs in and their case file is stored under users/{uid}/… in Firestore.
#
# Get them from: Firebase console → Project settings → General → Your apps →
# SDK setup and configuration → Config. Then, in the same project:
#   1. Build → Authentication → Sign-in method → enable Email/Password
#   2. Build → Firestore Database → Create database → Native mode
#      → location asia-south1 (Mumbai)
#   3. Firestore → Rules → paste the contents of `firestore.rules` → Publish
#   4. Authentication → Settings → Authorized domains → add your Render domain
#
# These are NEXT_PUBLIC_*, so they are baked into the browser bundle. That is
# expected and safe for Firebase client config — access is enforced by the
# Firestore rules, not by hiding these values. What must never be committed is
# a service-account JSON, and this app does not use one (no Admin SDK).
#
# ⚠ Render gotcha: NEXT_PUBLIC_* vars are inlined at BUILD time. They must exist
# in Render's environment before the first build, and changing one needs a
# rebuild (Clear build cache & deploy) — a restart will not pick it up.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Live blockchain tracing ─────────────────────────────────────────────────
# With these set, /api/trace walks the money live instead of using the demo
# dataset. Missing a chain's key simply means that chain contributes nothing.
#   Etherscan (Ethereum + Polygon, ERC-20/USDT):  https://etherscan.io/apis
#     One key covers both chains via the V2 multichain endpoint (?chainid=).
#     Verified 2026-08-26: chainid=1 and chainid=137 both return live data.
#   TronGrid  (TRON, TRC-20/USDT):                https://www.trongrid.io/
#   Bitcoin uses mempool.space and needs no key.
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=

# Escape hatch: repoint the Etherscan host without a code change (a V1 fallback
# if V2 is ever retired, or a local stub in tests). Leave unset in normal use.
# ETHERSCAN_API_BASE=https://api.etherscan.io/v2/api

# ── Token pricing ───────────────────────────────────────────────────────────
# CoinGecko, for live USD/INR values. Strongly recommended: the amount stated
# in a Section 91 / Section 94 notice is derived from these, and without a key
# the app falls back to a static table that will drift from the market.
# A free "Demo" key works: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# Set to true ONLY for a paid Pro key. Both Demo and Pro keys start with "CG-",
# so the prefix cannot tell them apart — and a Demo key sent to the Pro host is
# rejected with HTTP 400, after which prices silently revert to the static
# table. Leave this unset unless you are actually paying for Pro.
# COINGECKO_PRO=true

# ── AI narrative (I4C assistant) ────────────────────────────────────────────
# Google Gemini key. Without it, the assistant degrades to the local four-agent
# report — it never shows an error. The code also reads GOOGLE_API_KEY /
# GOOGLE_GENERATIVE_AI_API_KEY / GOOGLE_AI_API_KEY, but GEMINI_API_KEY is the
# name to prefer so the next person can find it.
GEMINI_API_KEY=

# Per-minute token budget for the governor (input+output). Optional; the app
# ships a sane default. Raise or lower to match your Gemini quota.
# GEMINI_TPM=32000

# ── Alchemy (optional: enhanced EVM tracing + historical valuation) ──────────
# When set, EVM chains (Ethereum, Polygon) trace via Alchemy's single-call
# getAssetTransfers instead of the two-call Etherscan path, and each transfer is
# additionally valued at its block-time price — the "incident loss" figure for
# an FIR, as against the current-spot "seizure value". Without it, tracing falls
# back to Etherscan and valuation to current spot; nothing breaks.
#
# ⚠ SECURITY: never hard-code this key in source. A collaborator prototype once
# committed a live key to the repo — treat any committed key as burned and
# rotate it in the Alchemy dashboard. This app reads it from the environment ONLY.
#   Get a key: https://dashboard.alchemy.com/  (free tier is ample)
ALCHEMY_API_KEY=

# ── Neo4j (optional: persisted fund-flow graph projection) ───────────────────
# The Crime Canvas and /api/graph run fully in-memory over the current trace.
# Setting these upgrades the graph to a persisted, Cypher-queryable projection
# (shortest-path-to-VASP verified in the database). Postgres stays the system of
# record; Neo4j holds no evidence and is a rebuildable projection, so the app is
# fully functional with these unset. Credentials are read from env only and are
# never logged. Try Neo4j Aura (free tier) or a local `docker run neo4j`.
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# ── Python ML sidecar (optional: real GDS + XGBoost + A*) ────────────────────
# The Crime Canvas and /api/graph run fully in-memory with the TypeScript
# heuristic when this is unset. Point it at the FastAPI service in `ml-service/`
# (see ml-service/README.md) and /api/graph will additionally:
#   • adopt REAL graph-data-science features — PageRank, betweenness, Louvain
#     community size, clustering — computed with NetworkX (or Neo4j GDS if the
#     sidecar itself has NEO4J_* set), replacing the in-memory approximations;
#   • blend in a per-wallet XGBoost fraud probability (0–100), shown as
#     "Fraud probability" in the wallet card (demonstration model, synthetic data);
#   • return a genuine A* (f = g + h) victim→VASP path with per-hop g/h/f.
# On ANY failure (unset, unreachable, timeout, bad response) the route silently
# falls back to the in-memory heuristic — nothing breaks. Run the sidecar with
# `cd ml-service && pip install -r requirements.txt && uvicorn app.main:app`.
# ML_SERVICE_URL=http://127.0.0.1:8000


# ── Real-time wallet monitor (quota-safe live surveillance) ──────────────────
# The Live Monitor view watches suspect addresses and raises an alert the moment
# one moves funds. It is safe to leave every setting at its default. The loop
# only runs once an officer opens the Monitor view, and it only reaches the chain
# when a live provider key (ALCHEMY_API_KEY / TRONGRID_API_KEY above) is set —
# with none, the watchlist is stored but nothing is polled and no alert is faked.
#
# HOW IT STAYS CHEAP: each poll asks the 2-call "has anything moved?" question
# (blockchain.ts probeSeedActivity); the full multi-hop trace runs ONLY when a
# watched address actually moves funds. Every call still passes the same per-lane
# DAILY_BUDGET gate as a manual trace, so the monitor can never exceed that ceiling.
#
#   MONITOR_ENABLED           true to run the loop (default), false to keep it dormant.
#   MONITOR_POLL_MS           ms between loop ticks. Default 60000; floor 30000 (a
#                             tighter interval is refused, to protect the key).
#   MONITOR_MAX_PROBES_PER_TICK  addresses probed per tick, staggering cost. Default 5.
#   MONITOR_MAX_WATCHES       ceiling on watched addresses. Default 25.
#   MONITOR_TRACE_HOPS        hop depth of the escalation trace. Default 4 (max 5).
# MONITOR_ENABLED=true
# MONITOR_POLL_MS=60000
# MONITOR_MAX_PROBES_PER_TICK=5
# MONITOR_MAX_WATCHES=25
# MONITOR_TRACE_HOPS=4


# ── Durable local store (file-backed prototype DB) ───────────────────────────
# Cases, users, freeze notices and signed orders are written to a JSON snapshot
# on disk so they survive a server restart (the earlier in-memory-only store
# lost every filed complaint, created account and assignment on reboot). This is
# the SOURCE OF TRUTH; Postgres below, when reachable, is a best-effort replica.
# The default location is `.data/store.json` under the app directory. Override
# the directory here if you need it elsewhere. The file holds password hashes +
# salts like a real users table — it is gitignored and must never be committed.
# DATA_DIR=.data

# ── PostgreSQL (optional replica / IAM store) ────────────────────────────────
# Entirely optional. With a reachable Postgres the app mirrors the cases and
# users tables to it (and stores the audit-log ring); with none, the durable
# JSON store above is fully sufficient. Connection is attempted once at boot
# with a 1.5s timeout and silently disabled on failure — nothing breaks.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=crypto_attribution

# ── Keycloak (optional: enterprise IAM) ──────────────────────────────────────
# When a Keycloak realm is reachable the app verifies RS256 tokens against its
# JWKS and can provision/delete users in it from the System Admin console. When
# it is offline the app falls back to native HS256 auth and local user CRUD —
# accounts still persist to the durable store, they just aren't mirrored to
# Keycloak until it returns. Import `keycloak/realm-export.json` (realm sih-lea,
# 8 roles, client cryptotrace-frontend) to bootstrap.
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=sih-lea
# KEYCLOAK_CLIENT_ID=cryptotrace-frontend
# KEYCLOAK_CLIENT_SECRET=

# Admin credentials used ONLY for user provisioning via the Admin REST API
# (password grant against the master realm, admin-cli client). Required only if
# you want "create/delete user" in the System Admin console to reach Keycloak;
# leave unset to keep user CRUD purely local. These are read from env ONLY and
# are never logged. Defaults match a stock `docker run keycloak` dev instance —
# CHANGE THEM for any non-local deployment.
# KEYCLOAK_ADMIN_USER=admin
# KEYCLOAK_ADMIN_PASSWORD=Admin@123
